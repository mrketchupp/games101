{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "games101-multiplayer",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "PaintRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PaintRoom"] }
  ]
}
